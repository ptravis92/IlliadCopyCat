{
  "manifest_version": 3,
  "name": "IlliadCopyCat",
  "version": "0.1.0",
  "description": "",
  "permissions": ["storage", "scripting"],
  "background": {
    "service_worker": "background/index.js"
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "*://search.worldcat.org/*",
        "*://www.worldcat.org/oclc/*",
        "*://firstsearch.oclc.org/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
